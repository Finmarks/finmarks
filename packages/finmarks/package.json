{
  "name": "@finmarks/finmarks",
  "version": "0.1.0",
  "description": "Logos and structured metadata for the Indian fintech ecosystem — banks, UPI apps, gateways, neobanks, AAs and more",
  "keywords": [
    "india",
    "fintech",
    "logos",
    "brand-assets",
    "upi",
    "banks",
    "npci",
    "rbi",
    "account-aggregator",
    "svg"
  ],
  "license": "MIT",
  "homepage": "https://Finmarks.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Finmarks/Finmarks.git",
    "directory": "packages/finmarks"
  },
  "bugs": "https://github.com/Finmarks/Finmarks/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./index.json": "./data/index.json",
    "./categories.json": "./data/categories.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node scripts/copy-data.mjs",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node --test test/*.test.mjs",
    "pretypecheck": "node scripts/copy-data.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}