---
import Base from '../../layouts/Base.astro';
import Browser from '../../components/Browser';
import { CDN_BASE, activeCategories, browseData, type CategoryInfo, type BrowseEntity } from '../../lib/data';
import { breadcrumbList, fitTitle, itemList } from '../../lib/seo';

export function getStaticPaths() {
  return activeCategories.map((c) => ({
    params: { id: c.id },
    props: { category: c, list: browseData.filter((e) => e.categories.includes(c.id)) },
  }));
}

interface Props {
  category: CategoryInfo;
  list: BrowseEntity[];
}

const { category: c, list } = Astro.props;
const sourced = list.filter((e) => e.variants.length > 0).length;

const title = fitTitle([
  `${c.label} in India: Logos & Brand Data | Finmarks`,
  `${c.label} in India: Logos & Data | Finmarks`,
  `${c.label} in India | Finmarks`,
]);
const description = `${c.count} ${c.label} in India, regulated by ${c.regulator}. Free SVG logos and structured metadata for each.`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${c.label} in India`,
    description: c.description,
    url: new URL(`/categories/${c.id}/`, Astro.site).href,
    isPartOf: { '@type': 'WebSite', url: new URL('/', Astro.site).href },
    mainEntity: itemList(list, Astro.site),
  },
  breadcrumbList(
    [
      ['Home', '/'],
      ['Categories', '/categories/'],
      [c.label, `/categories/${c.id}/`],
    ],
    Astro.site,
  ),
];
---

<Base title={title} description={description} schema={schema}>
  <div class="wrap page">
    <div class="crumbs-bar">
      <a
        href="/categories/"
        id="back-btn"
        class="ghost-btn back-btn"
        onclick="if (window.history.length > 1 && document.referrer && document.referrer.startsWith(window.location.origin)) { window.history.back(); return false; }"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
        Back
      </a>
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true" class="crumb-sep">/</span>
        <a href="/categories/">Categories</a>
        <span aria-hidden="true" class="crumb-sep">/</span>
        <span aria-current="page">{c.label}</span>
      </nav>
    </div>

    <Browser client:load entities={list} categories={[]} cdnBase={CDN_BASE} hideSidebar={true}>
      <header class="head">
        <p class="eyebrow">Category · regulated by {c.regulator}</p>
        <h1>{c.label}</h1>
        <p class="desc">{c.description}</p>
      </header>
    </Browser>
  </div>
</Base>

<style>
  .page {
    padding-block: 1rem 4rem;
  }
  .crumbs-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .crumbs {
    font-family: var(--mono);
    font-size: var(--step--1);
    color: var(--ink-3);
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .crumbs a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--step--1);
    font-weight: 500;
    flex-shrink: 0;
  }
  .crumb-sep {
    color: var(--line-strong);
    margin: 0 0.2rem;
  }
  .head {
    margin-bottom: 1.25rem;
  }
  h1 {
    font-size: var(--step-2);
    margin-block: 0.25rem 0.4rem;
  }
  .desc {
    color: var(--ink-2);
    max-width: 60ch;
  }
</style>
