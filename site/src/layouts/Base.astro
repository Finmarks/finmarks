---
import "../styles/global.css";
import { VERSION, GENERATED_AT } from "../lib/data";
import SidebarLinks, { SidebarBottom } from "../components/SidebarLinks";

interface Props {
  title: string;
  description: string;
  /**
   * Optional OG image path, relative to the site root. Must be a raster format:
   * Facebook, LinkedIn, X, Slack and WhatsApp all refuse SVG. Entity pages used
   * to pass their logo SVG here, which is why every share rendered blank.
   * Omit it to get the sitewide card below.
   */
  ogImage?: string;
  hideHeader?: boolean;
  /**
   * JSON-LD for this page — one object or several. Rendered into <head> as a
   * single graph so a page can describe itself as, say, both an Organization
   * and a BreadcrumbList without emitting duplicate <script> tags.
   */
  schema?: Schema | Schema[];
}

type Schema = Record<string, unknown>;

const { title, description, ogImage, hideHeader = false, schema } = Astro.props;

/**
 * The sitewide social card, used by every page that does not supply its own.
 *
 * Derived from public/fintech_india.webp — the homepage hero — cropped to the
 * 1.91:1 box Facebook, LinkedIn and X all render, and encoded as JPEG rather
 * than kept as WebP because LinkedIn and WhatsApp do not reliably unfurl WebP.
 * Regenerate after changing the hero with:
 *
 *   node -e "require('sharp')('public/fintech_india.webp')\
 *     .resize(1200,630,{fit:'cover'}).jpeg({quality:82,mozjpeg:true})\
 *     .toFile('public/og-default.jpg')"
 */
const OG_DEFAULT = {
  path: "/og-default.jpg",
  width: 1200,
  height: 630,
  type: "image/jpeg",
  alt: "Finmarks — free SVG logos and structured brand data for the Indian fintech ecosystem",
};

const ogPath = ogImage ?? OG_DEFAULT.path;
const ogUrl = new URL(ogPath, Astro.site);
// Dimensions and type describe the default card specifically, so they are only
// emitted when that is what is actually being served — a page supplying its own
// image would otherwise advertise the wrong size and get cropped oddly.
const ogIsDefault = ogPath === OG_DEFAULT.path;

const schemas: Schema[] = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
// Several objects become one @graph. Each arrives carrying its own @context
// (they are built independently and are valid alone); the graph declares it
// once, so drop the now-redundant copies rather than nesting them.
const jsonLd =
  schemas.length === 0
    ? null
    : schemas.length === 1
      ? schemas[0]
      : {
          '@context': 'https://schema.org',
          '@graph': schemas.map(({ '@context': _context, ...rest }) => rest),
        };
const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";

// Both IDs are public by design — every analytics install ships them in the
// page source. The literals are the fallback so the tags survive whichever
// path builds the site: a Cloudflare Pages Git build never sees the GitHub
// Actions variables in .github/workflows/site.yml. Setting the env var still
// overrides, which is how a fork points the site at its own property.
// Empty-string check, not `??`: an unset Actions variable expands to "".
// Guarded on PROD so `astro dev` never lands local browsing in the reports.
const gaId =
  import.meta.env.GA_MEASUREMENT_ID || (import.meta.env.PROD ? "G-HRD0EBS9LD" : "");
const clarityId =
  import.meta.env.CLARITY_PROJECT_ID || (import.meta.env.PROD ? "y26e4i6pe2" : "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Finmarks" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    {
      ogIsDefault && (
        <>
          <meta property="og:image:width" content={String(OG_DEFAULT.width)} />
          <meta property="og:image:height" content={String(OG_DEFAULT.height)} />
          <meta property="og:image:type" content={OG_DEFAULT.type} />
          <meta property="og:image:alt" content={OG_DEFAULT.alt} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <!-- X reads og:image, but naming it explicitly avoids depending on that
         fallback, and lets the alt text differ from the OG one if ever needed. -->
    <meta name="twitter:image" content={ogUrl} />
    {ogIsDefault && <meta name="twitter:image:alt" content={OG_DEFAULT.alt} />}

    <!-- Matches --ground in global.css, per scheme, so the mobile browser
         chrome does not sit in the opposite theme to the page. -->
    <meta name="theme-color" content="#fcfcfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0e12" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!--
      Loaded without blocking the first paint. A plain stylesheet link to
      fonts.googleapis.com holds rendering on a third-party round trip, which
      lands directly on LCP; `media="print"` makes it a non-blocking fetch that
      is promoted to `all` once it arrives. `display=swap` is already set, so
      text paints in the fallback face either way — this only stops the whole
      page waiting on it. The fallback below keeps the fonts when scripting is
      off, since the media swap depends on the onload handler running.
    -->
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Lexend:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'; this.onload=null;"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Lexend:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!--
      Applied before first paint so visitor never sees a theme flash.
      Defaults to 'light' if not explicitly set.
    -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("bb-theme");
          var theme = saved || "light";
          if (theme === "dark" || theme === "light") {
            document.documentElement.setAttribute("data-theme", theme);
          } else if (theme === "system") {
            document.documentElement.removeAttribute("data-theme");
          }
        } catch (e) {}
      })();
    </script>
    <!--
      Deferred: this only powers the data-tally-open buttons inside the Browser
      island, which cannot be clicked until React has hydrated anyway. Without
      `defer` it blocked first paint on all 190 pages waiting on a third-party
      host, for a widget nothing needs during the initial render.
    -->
    <script is:inline defer src="https://tally.so/widgets/embed.js"></script>

    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          // Assigned onto window, not declared: define:vars wraps this block in
          // an IIFE, so a bare `function gtag()` would be scoped to it and any
          // later gtag("event", ...) call would find no global.
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          gtag("js", new Date());
          gtag("config", gaId);
        </script>
      </>
    )}

    {clarityId && (
      <script is:inline define:vars={{ clarityId }}>
        (function (c, l, a, r, i, t, y) {
          c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
          t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
          y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
        })(window, document, "clarity", "script", clarityId);
      </script>
    )}
  </head>

  <body>
    <a href="#main" class="sr">Skip to content</a>

    {!hideHeader ? (
      <div class={`app-layout ${isHome ? 'is-home-layout' : ''}`}>
        <header class="mobile-header">
          <a class="brand" href="/" aria-label="Finmarks">
            <img src="/finmark_light.svg" alt="Finmarks" class="logo-light brand-logo" />
            <img src="/finmark_dark.svg" alt="Finmarks" class="logo-dark brand-logo" />
          </a>
          <button class="menu-toggle" aria-label="Toggle Menu" id="mobile-menu-toggle">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
          </button>
        </header>

        <div class="mobile-overlay" id="mobile-overlay" aria-hidden="true"></div>
        
        <aside class="app-sidebar" id="app-sidebar">
          <div class="rail-scroll">
            <SidebarLinks currentPath={Astro.url.pathname} />
          </div>
          <SidebarBottom client:load />
        </aside>
        
        <main class="app-main" id="main">
          <slot />
        </main>
      </div>
    ) : (
      <main id="main">
        <slot />
      </main>
    )}

    <script is:inline>
      // Mobile sidebar toggle logic
      const menuToggle = document.getElementById("mobile-menu-toggle");
      const overlay = document.getElementById("mobile-overlay");
      const sidebarLinks = document.querySelectorAll("#app-sidebar .nav-link");

      function toggleSidebar() {
        document.body.classList.toggle("sidebar-open");
      }

      function closeSidebar() {
        document.body.classList.remove("sidebar-open");
      }

      if (menuToggle) menuToggle.addEventListener("click", toggleSidebar);
      if (overlay) overlay.addEventListener("click", closeSidebar);
      
      // Close sidebar when clicking any navigation link on mobile
      sidebarLinks.forEach(link => {
        link.addEventListener("click", () => {
          if (window.innerWidth < 940) closeSidebar();
        });
      });

      // Desktop progressive scroll reveal for sidebar on homepage
      (function initHomeScrollSidebar() {
        const appLayout = document.querySelector(".app-layout.is-home-layout");
        const appMain = document.getElementById("main");
        const sidebar = document.getElementById("app-sidebar");

        if (!appLayout || !appMain || !sidebar) return;

        let ticking = false;

        function updateSidebar() {
          ticking = false;
          if (window.innerWidth < 940) {
            appLayout.style.removeProperty("--home-rail-offset");
            sidebar.style.removeProperty("transform");
            sidebar.style.removeProperty("opacity");
            sidebar.style.removeProperty("pointer-events");
            return;
          }

          const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (prefersReduced) {
            appLayout.style.setProperty("--home-rail-offset", "var(--rail)");
            sidebar.style.transform = "translateX(0)";
            sidebar.style.opacity = "1";
            sidebar.style.pointerEvents = "auto";
            return;
          }

          const universalFeature = document.getElementById("feature-universal-asset");
          const cdnFeature = document.getElementById("feature-cdn");
          const scrollTop = appMain.scrollTop || 0;
          
          // Calculate destination target offset (when snapping to Universal Asset Repo / features container)
          let targetOffset = 500;
          if (universalFeature) {
            targetOffset = Math.max(150, universalFeature.offsetTop * 0.7);
          } else if (cdnFeature) {
            targetOffset = Math.max(150, cdnFeature.offsetTop - (appMain.clientHeight * 0.45));
          }

          const progress = Math.min(Math.max(scrollTop / targetOffset, 0), 1);
          // Easing function for smooth organic slide-in
          const eased = Math.sin((progress * Math.PI) / 2);

          // Get rail width in px (standard desktop rail is 224px)
          const railWidth = 224;
          const currentOffset = eased * railWidth;

          appLayout.style.setProperty("--home-rail-offset", `${currentOffset.toFixed(2)}px`);
          const translateX = (1 - eased) * -100;
          sidebar.style.transform = `translateX(${translateX.toFixed(2)}%)`;
          sidebar.style.opacity = (eased * 1.0).toFixed(3);
          sidebar.style.pointerEvents = progress > 0.08 ? "auto" : "none";
        }

        function onScroll() {
          if (!ticking) {
            window.requestAnimationFrame(updateSidebar);
            ticking = true;
          }
        }

        appMain.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
        // Run once on init
        updateSidebar();
      })();
    </script>
  </body>
</html>
